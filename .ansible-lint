---
# Use ansible-lint defaults (includes prettier-compatible yamllint).
profile: basic
exclude_paths:
  - .ansible/
  - .cache/
  - .github/
  - dist/
# Existing public APIs use names such as commitHash, node_*, serverCodePath.
# Do not rewrite those in the CI bootstrap PR.
skip_list:
  - var-naming[no-role-prefix]
  - var-naming[pattern]
  - name[missing]
  - command-instead-of-shell
  - command-instead-of-module
  - yaml[line-length]
