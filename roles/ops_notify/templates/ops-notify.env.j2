# Managed by Ansible role kristijorgji.devops.ops_notify. Do not edit on the host.
OPS_NOTIFY_EMAIL_TO={{ ops_notify_email_to | join(',') | quote }}
OPS_NOTIFY_EMAIL_FROM={{ ops_notify_email_from | quote }}
OPS_NOTIFY_SENDGRID_API_KEY={{ ops_notify_sendgrid_api_key | quote }}
OPS_NOTIFY_SMTP_HOST={{ ops_notify_smtp_host | quote }}
OPS_NOTIFY_SMTP_PORT={{ ops_notify_smtp_port | quote }}
OPS_NOTIFY_SMTP_USER={{ ops_notify_smtp_user | quote }}
OPS_NOTIFY_SMTP_PASSWORD={{ ops_notify_smtp_password | quote }}
{% set ns = namespace(webhooks='') -%}
{% for w in ops_notify_webhooks -%}
{% set ns.webhooks = ns.webhooks + w.format + '|' + w.url + ('\n' if not loop.last else '') -%}
{% endfor -%}
OPS_NOTIFY_WEBHOOKS={{ ns.webhooks | quote }}
{% for name, url in (ops_notify_healthchecks | default({})).items() -%}
OPS_NOTIFY_HC_{{ name | replace('-', '_') | replace('.', '_') | replace(' ', '_') | upper }}={{ url | quote }}
{% endfor %}
